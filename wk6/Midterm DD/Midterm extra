SELECT TRIM(Genre) AS Genre, COUNT("IMBD title ID") AS "Movie Count"
FROM (
    SELECT "IMBD title ID", Genre_1 AS Genre FROM "Movie Analysis"
    UNION ALL
    SELECT "IMBD title ID", Genre_2 FROM "Movie Analysis"
    UNION ALL
    SELECT "IMBD title ID", Genre_3 FROM "Movie Analysis"
)
WHERE Genre IS NOT NULL AND TRIM(Genre) != '' -- (practice TRIM in the future)
GROUP BY TRIM(Genre)
ORDER BY "Movie Count" DESC;

